    },
    {
      "问题": "栖霞园预警线出屏崩溃",
      "位置": "mod/GAME/th43/runtime.lua",
      "处理": "隔离引擎删除原因与原作del第二参数淡出帧数，保留显式del(o,帧数)。"
    },
    {
      "问题": "Like Dreamer绘制阶段创建对象崩溃",
      "位置": "LikeDreamer/boss_early.lua、boss_middle.lua、enemy.lua",
      "处理": "分层与血条代理在逻辑阶段准备，绘制阶段只读；无效宿主不再解引用。"
    },
    {
      "问题": "安卓曲线激光缺少包络接口",
      "位置": "android/lua/compat.lua；android/native/bent_laser_envelope.inc",
      "处理": "补齐Set/GetEnvelope及节点碰撞，保留活动节点和固定宽度语义，不改绘制宽度；完整重编原生库。"
    },
    {
      "问题": "夏夜祭扔雷后读取已删除对象",
      "位置": "mod/GAME/th40/native.lua",
      "处理": "原生对象先IsValid再读字段，保留普通表流程宿主的owner判断。"
    }
